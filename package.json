{
  "name": "supermarket",
  "version": "1.0.0",
  "description": "Supermarket - a cooperative 1-4 player multiplayer supermarket building & management game.",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node tests/sim.test.js && node tests/multiplayer.test.js && node tests/p2p.test.js && node tests/steam-service.test.js && DAYS=8 node tests/soak.test.js",
    "test:browser": "node tests/browser-e2e.mjs",
    "showcase": "node tests/browser-showcase.mjs",
    "build:static": "node tools/build-static.mjs",
    "test:all": "npm test && node tests/browser-e2e.mjs && node tests/browser-ui.mjs && node tools/build-static.mjs && node tests/browser-static.mjs && node tests/browser-soak.mjs",
    "desktop": "electron .",
    "desktop:offline": "electron . --no-steam",
    "dist:linux": "node tools/prepare-desktop.mjs && electron-builder --linux --x64",
    "dist:win": "node tools/prepare-desktop.mjs && electron-builder --win --x64",
    "dist:mac": "node tools/prepare-desktop.mjs && electron-builder --mac --universal",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "steam:achievements": "node tools/steam-achievements.mjs",
    "steam:assets": "node tools/steam-assets.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "steamworks.js": "^0.4.0",
    "three": "0.170.0",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "productName": "Supermarket",
  "author": {
    "name": "Supermarket"
  }
}

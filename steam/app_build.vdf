"AppBuild"
{
	// SteamPipe build script. Replace 480/481/482/483 with your App ID and your three depot IDs
	// (Steamworks > your app > SteamPipe > Depots). Run from this folder:
	//   steamcmd +login <builder account> +run_app_build "%CD%\app_build.vdf" +quit
	"AppID" "480"
	"Desc" "Supermarket desktop build"
	"BuildOutput" "./output/"
	"ContentRoot" "../release/"
	"SetLive" ""
	"Depots"
	{
		"481" "depot_windows.vdf"
		"482" "depot_mac.vdf"
		"483" "depot_linux.vdf"
	}
}
